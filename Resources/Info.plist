         also pinned in code. SUEnableAutomaticChecks is deliberately absent: Snaptic sets it from the user's answer. -->
    <key>SUFeedURL</key>
    <string>https://github.com/revylfitness/snaptic/releases/latest/download/appcast.xml</string>
    <key>SUPublicEDKey</key>
    <string>P/QyXVQX6nBYXfuNXlR8trb8+r8A5zyYAQEVyYucW4k=</string>
    <key>SUVerifyUpdateBeforeExtraction</key>
    <true/>
    <key>SURequireSignedFeed</key>
    <true/>
    <key>SUEnableSystemProfiling</key>
    <false/>
    <key>SUScheduledCheckInterval</key>
    <integer>86400</integer>
</dict>
</plist>
